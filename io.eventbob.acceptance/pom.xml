<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.eventbob</groupId>
        <artifactId>io.eventbob.parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>io.eventbob.acceptance</artifactId>
    <packaging>jar</packaging>

    <name>EventBob Acceptance Tests</name>
    <description>Docker/Testcontainers-based acceptance tests proving Dropwizard/Spring
        realization parity for the "As a Developer" business use case. Test-only module: no
        production (src/main) sources.
    </description>

    <properties>
        <!-- Real, already-built fat jars this module's Dockerfiles COPY as opaque inputs. -->
        <dw.echo.jar>${maven.multiModuleProjectDirectory}/io.eventbob.example/io.eventbob.example.microlith.dw.echo/target/io.eventbob.example.microlith.dw.echo-${project.version}.jar</dw.echo.jar>
        <spring.echo.jar>${maven.multiModuleProjectDirectory}/io.eventbob.example/io.eventbob.example.microlith.spring.echo/target/io.eventbob.example.microlith.spring.echo-${project.version}.jar</spring.echo.jar>
        <!-- Phase 2: the "upper" remote capability's fat jars and (Dropwizard-only) its
             already-existing, unmodified config.yml, COPYd as opaque Docker inputs into the
             two-process echo+upper images (see Images#dwEchoAndUpper/#springEchoAndUpper). -->
        <dw.upper.jar>${maven.multiModuleProjectDirectory}/io.eventbob.example/io.eventbob.example.microlith.dw.upper/target/io.eventbob.example.microlith.dw.upper-${project.version}.jar</dw.upper.jar>
        <spring.upper.jar>${maven.multiModuleProjectDirectory}/io.eventbob.example/io.eventbob.example.microlith.spring.upper/target/io.eventbob.example.microlith.spring.upper-${project.version}.jar</spring.upper.jar>
        <dw.upper.config>${maven.multiModuleProjectDirectory}/io.eventbob.example/io.eventbob.example.microlith.dw.upper/src/main/resources/config.yml</dw.upper.config>
        <!-- Phase 3: the broken images now run from each framework's own independently-shaded
             fat jar (io.eventbob.acceptance.broken.dw / .spring), built with a clean,
             single-framework dependency tree - the same proven approach the good images already
             use - rather than a merged classpath sourced from this module's own compile-scope
             dependencies. See those modules' pom.xml comments for why (mutual Dropwizard/Spring
             Logback binary incompatibility). -->
        <dw.broken.jar>${maven.multiModuleProjectDirectory}/io.eventbob.acceptance.broken.dw/target/io.eventbob.acceptance.broken.dw-${project.version}.jar</dw.broken.jar>
        <spring.broken.jar>${maven.multiModuleProjectDirectory}/io.eventbob.acceptance.broken.spring/target/io.eventbob.acceptance.broken.spring-${project.version}.jar</spring.broken.jar>
        <!-- Phase 4: the non-EventBob decoy "upper" application used by
             RemoteCapabilityFailureAcceptanceTest to produce genuine HTTP-error / network-failure
             / slow-response conditions the real EventBob-based "upper" app can never itself
             produce (see io.eventbob.acceptance.decoy.upper's pom.xml). One jar serves both
             framework realizations: the same image build copies it in place of the real
             upper.jar, with MODE/PORT selected per test via container env vars. -->
        <decoy.upper.jar>${maven.multiModuleProjectDirectory}/io.eventbob.acceptance.decoy.upper/target/io.eventbob.acceptance.decoy.upper-${project.version}.jar</decoy.upper.jar>
        <jackson.version>2.21.0</jackson.version>
        <jackson.annotations.version>2.21</jackson.annotations.version>
    </properties>

    <dependencies>
        <!-- Testcontainers: raw container control (generic containers, image-from-Dockerfile). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Broken-lifecycle glue constants (BrokenMode.DUPLICATE_CAPABILITY etc.), needed by
             this module's own test sources to set the BROKEN_MODE env var when starting a
             container. Deliberately test scope: this module has no src/main, and the actual
             broken applications now live in their own dedicated single-framework modules (see
             .dw/.spring below) - this module never needs io.eventbob.dropwizard or
             io.eventbob.spring itself, which is the fix for the Logback incompatibility bug
             (see io.eventbob.acceptance.broken.common's pom.xml). -->
        <dependency>
            <groupId>io.eventbob</groupId>
            <artifactId>io.eventbob.acceptance.broken.common</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Reactor-ordering dependencies: force the two microlith modules (and the fat jars
             their build produces) to be built before this module's tests run. Not imported by
             any class here (both declare classes under the same io.eventbob.example.echo /
             io.eventbob.example.lower package names, so importing from both in one compilation
             unit would be an ambiguous split-package classpath; the broken-image lifecycle glue
             is defined once, in io.eventbob.acceptance.broken.common, instead). -->
        <dependency>
            <groupId>io.eventbob</groupId>
            <artifactId>io.eventbob.example.microlith.dw.echo</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.eventbob</groupId>
            <artifactId>io.eventbob.example.microlith.spring.echo</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.eventbob</groupId>
            <artifactId>io.eventbob.example.microlith.dw.upper</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.eventbob</groupId>
            <artifactId>io.eventbob.example.microlith.spring.upper</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Reactor-ordering-only dependencies: force the two new broken-image modules (and the
             shaded fat jars their build produces) to be built before this module's tests run.
             Never imported by any class here - only their built jars are consumed, as opaque
             Docker COPY inputs (see support/Images.java), exactly like the good echo/upper
             jars above. -->
        <dependency>
            <groupId>io.eventbob</groupId>
            <artifactId>io.eventbob.acceptance.broken.dw</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.eventbob</groupId>
            <artifactId>io.eventbob.acceptance.broken.spring</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Reactor-ordering-only dependency: forces the new decoy-upper module (and the plain
             jar its build produces) to be built before this module's tests run. Never imported
             by any class here - only its built jar is consumed, as an opaque Docker COPY input
             (see support/Images.java), exactly like the broken-image jars above. -->
        <dependency>
            <groupId>io.eventbob</groupId>
            <artifactId>io.eventbob.acceptance.decoy.upper</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Explicit, mutually-consistent Jackson pin for THIS module's own test classpath
             (support/EventClient.java uses ObjectMapper directly, on the host test JVM, never
             inside a container). Without this pin, the resolved test classpath silently mixes
             jackson-annotations:2.20 (from Testcontainers' own docker-java-api dependency) with
             jackson-core/jackson-databind:2.21.0 (transitively, via the dw.echo/dw.upper
             reactor-ordering test dependencies below pulling in Dropwizard's Jackson stack) -
             confirmed via dependency:tree. Both sets happen to stay binary-compatible today for
             EventClient's trivial Map<String,Object> (de)serialization, but that's incidental,
             not contractual: an unrelated Testcontainers or Dropwizard version bump could
             silently reintroduce the same class of NoSuchMethodError/NoClassDefFoundError this
             module already fixed once (see the Logback incompatibility this module's sibling
             modules were split to solve). Pinning removes the ambiguity the same way. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>${jackson.annotations.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- No unit tests in this module: everything here needs Docker and real fat jars
                 built by sibling reactor modules, so it runs as an integration test (failsafe,
                 bound to integration-test/verify, after package) rather than a unit test
                 (surefire, bound to test, before package). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*AcceptanceTest.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <eventbob.acceptance.dwEchoJar>${dw.echo.jar}</eventbob.acceptance.dwEchoJar>
                        <eventbob.acceptance.springEchoJar>${spring.echo.jar}</eventbob.acceptance.springEchoJar>
                        <eventbob.acceptance.dwEchoBrokenJar>${dw.broken.jar}</eventbob.acceptance.dwEchoBrokenJar>
                        <eventbob.acceptance.springEchoBrokenJar>${spring.broken.jar}</eventbob.acceptance.springEchoBrokenJar>
                        <eventbob.acceptance.dwUpperJar>${dw.upper.jar}</eventbob.acceptance.dwUpperJar>
                        <eventbob.acceptance.springUpperJar>${spring.upper.jar}</eventbob.acceptance.springUpperJar>
                        <eventbob.acceptance.dwUpperConfig>${dw.upper.config}</eventbob.acceptance.dwUpperConfig>
                        <eventbob.acceptance.decoyUpperJar>${decoy.upper.jar}</eventbob.acceptance.decoyUpperJar>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Removes every Docker image built by support/Images.java for this module's
                 acceptance tests (identified by the io.eventbob.acceptance=true label - see
                 Images.java's CLEANUP_LABEL), regardless of whether the failsafe-forked test JVM
                 exits cleanly. Bound to post-integration-test: Maven always reaches this phase
                 after integration-test completes (even on test failure) and before the verify
                 goal fails the build on results, so cleanup runs as a separate Maven-owned
                 process step on every real test invocation - unlike ImageFromDockerfile's
                 deleteOnExit JVM shutdown hook, which does not fire on a killed/forked JVM, and
                 unlike Ryuk-based reaping, whose availability this module does not control. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>cleanup-acceptance-images-post-test</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="bash" failonerror="false">
                                    <arg
                                        value="${project.basedir}/scripts/cleanup-acceptance-images.sh"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cleanup-acceptance-images-on-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="bash" failonerror="false">
                                    <arg
                                            value="${project.basedir}/scripts/cleanup-acceptance-images.sh"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
