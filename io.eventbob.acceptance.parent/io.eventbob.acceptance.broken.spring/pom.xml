<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.eventbob</groupId>
        <artifactId>io.eventbob.acceptance.parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>io.eventbob.acceptance.broken.spring</artifactId>
    <packaging>jar</packaging>

    <name>EventBob Acceptance Tests: Broken-Image Spring Application</name>
    <description>Spring-only broken-image application, packaged as its own repackaged fat jar so
        its dependency tree (and, critically, its Logback version) resolves independently of the
        Dropwizard broken image's tree - the fix for the mutual Dropwizard/Spring Logback
        incompatibility described in io.eventbob.acceptance.broken.common's pom.xml.
    </description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.eventbob</groupId>
            <artifactId>io.eventbob.spring</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.eventbob</groupId>
            <artifactId>io.eventbob.acceptance.broken.common</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.5.16</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>io.eventbob.acceptance.broken.spring.BrokenEchoApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
